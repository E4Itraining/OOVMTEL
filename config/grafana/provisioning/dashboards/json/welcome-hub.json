    {
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "<div style=\"background:linear-gradient(180deg,#1b263b 0%,#0d1b2a 100%);padding:20px 24px;border-radius:10px;border-left:4px solid #00d4aa\">\n  <h2 style=\"color:#00d4aa;margin:0 0 12px 0;font-size:20px;font-weight:700\">Bienvenue sur votre Centre de Pilotage Industriel</h2>\n  <p style=\"color:#e0e1dd;margin:0 0 16px 0;font-size:14px;line-height:1.7\">\n    OOVMTEL est votre plateforme centrale d'observabilite industrielle. Elle collecte, traite et visualise en temps reel l'ensemble des donnees de votre infrastructure IT/OT : <strong style=\"color:#00d4aa\">metriques de production</strong>, <strong style=\"color:#536dfe\">donnees SCADA</strong>, <strong style=\"color:#ffc107\">logs systemes</strong> et <strong style=\"color:#e94560\">traces applicatives</strong>.\n  </p>\n  <div style=\"display:flex;gap:20px;flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:200px;background:rgba(0,212,170,0.1);padding:12px;border-radius:8px;border:1px solid rgba(0,212,170,0.3)\">\n      <h4 style=\"color:#00d4aa;margin:0 0 6px 0;font-size:13px\">Collecte Temps Reel</h4>\n      <p style=\"color:#a0a0a0;margin:0;font-size:12px\">OpenTelemetry & Kafka pour une ingestion haute performance de vos donnees industrielles</p>\n    </div>\n    <div style=\"flex:1;min-width:200px;background:rgba(83,109,254,0.1);padding:12px;border-radius:8px;border:1px solid rgba(83,109,254,0.3)\">\n      <h4 style=\"color:#536dfe;margin:0 0 6px 0;font-size:13px\">Stockage Performant</h4>\n      <p style=\"color:#a0a0a0;margin:0;font-size:12px\">VictoriaMetrics & OpenSearch pour des requetes ultra-rapides sur vos historiques</p>\n    </div>\n    <div style=\"flex:1;min-width:200px;background:rgba(255,193,7,0.1);padding:12px;border-radius:8px;border:1px solid rgba(255,193,7,0.3)\">\n      <h4 style=\"color:#ffc107;margin:0 0 6px 0;font-size:13px\">Visualisation Avancee</h4>\n      <p style=\"color:#a0a0a0;margin:0;font-size:12px\">Dashboards Grafana adaptes a chaque profil metier pour une prise de decision eclairee</p>\n    </div>\n    <div style=\"flex:1;min-width:200px;background:rgba(233,69,96,0.1);padding:12px;border-radius:8px;border:1px solid rgba(233,69,96,0.3)\">\n      <h4 style=\"color:#e94560;margin:0 0 6px 0;font-size:13px\">Alerting Intelligent</h4>\n      <p style=\"color:#a0a0a0;margin:0;font-size:12px\">Notifications proactives et maintenance predictive pour anticiper les incidents</p>\n    </div>\n  </div>\n</div>",
        "mode": "html"
      },
