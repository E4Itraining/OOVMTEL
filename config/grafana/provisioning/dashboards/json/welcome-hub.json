        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "<div style=\"text-align:center;background:linear-gradient(135deg,#0d1b2a 0%,#1b263b 50%,#415a77 100%);padding:24px;border-radius:12px;border:2px solid #778da9;box-shadow:0 8px 32px rgba(0,0,0,0.3)\">\n  <h1 style=\"color:#e0e1dd;margin:0;font-size:36px;font-weight:800;letter-spacing:3px;text-shadow:2px 2px 4px rgba(0,0,0,0.5)\">OOVMTEL</h1>\n  <p style=\"color:#778da9;margin:8px 0 0 0;font-size:16px;font-weight:500\">Open Observability Platform for Industrial & Manufacturing Telemetry</p>\n  <p style=\"color:#415a77;margin:4px 0 0 0;font-size:13px\">Plateforme unifiee de supervision temps reel | Convergence IT/OT | Industrie 4.0</p>\n</div>",
