# =============================================================================
# OOVMTEL Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# OpenObserve
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123

# Kafka
KAFKA_HEAP_OPTS=-Xmx2g -Xms2g

# Victoria Metrics
VM_RETENTION_PERIOD=90d

# OpenSearch
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

# Simulators
SCADA_DATA_RATE=500
MES_DATA_RATE=100
PLM_DATA_RATE=20
OPCUA_DATA_RATE=200

# =============================================================================
# LLM Configuration (for AI-enhanced NLP features)
# =============================================================================

# Active LLM Provider (mistral, claude, openai, ollama)
LLM_PROVIDER=mistral

# Enable/Disable LLM features (falls back to rule-based NLP if disabled)
LLM_ENABLED=true
LLM_FALLBACK_TO_RULES=true

# Mistral Configuration
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TEMPERATURE=0.3
MISTRAL_MAX_TOKENS=2048

# Claude Configuration (for future use)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-3-sonnet-20240229

# Response Caching
LLM_CACHE_RESPONSES=true
LLM_CACHE_TTL_SECONDS=300

# Rate Limiting
LLM_MAX_REQUESTS_PER_MINUTE=60

# Debugging (set to true for development, false in production)
LLM_LOG_PROMPTS=false
LLM_LOG_RESPONSES=false
